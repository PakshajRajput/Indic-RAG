# .env.example — copy to .env and fill in your keys
# NEVER commit .env to git

# LangSmith tracing (optional — set to false to disable)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=indicrag-abstain
LANGSMITH_TRACING=true

# Hosted LLM APIs (at least one required for Phases 4+)
GOOGLE_API_KEY=your_google_ai_studio_key_here
TOGETHER_API_KEY=your_together_ai_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# HuggingFace (for gated models e.g. Llama)
HF_TOKEN=your_huggingface_token_here

# Random seed (do not change after Phase 1 data split)
SEED=42

# Data paths (relative to repo root; override if needed)
DATA_DIR=data
RESULTS_DIR=results
CACHE_DIR=.cache
